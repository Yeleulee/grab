# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In production these are set as Render environment variables (npm run render:env -- KEY VALUE).

# Firebase web app config (Firebase console > Project settings > Your apps > SDK setup and configuration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Sign-in methods shown on the login screen: google, password
FIREBASE_PROVIDERS=google,password
# Optional: set to 1 AFTER adding https://<your-domain>/__/auth/handler to the OAuth client's
# "Authorized redirect URIs" in Google Cloud Console. Makes redirect sign-in work on browsers that block
# third-party storage by serving Firebase's auth helper from your own domain (README → "Login with Firebase").
FIREBASE_AUTH_PROXY=0