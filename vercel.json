{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/vercel-config.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/landing" },
    { "source": "/__/auth/:path*", "destination": "https://grab-8ce58.firebaseapp.com/__/auth/:path*" },
    { "source": "/vendor/firebase/:path*", "destination": "https://balanced-heart-production-d605.up.railway.app/vendor/firebase/:path*" }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/vendor/firebase/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    },
    {
      "source": "/(.*)\\.(png|css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
